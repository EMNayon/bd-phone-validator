{
    "name": "sanvalabs/bd-phone-validator",
    "description": "Validate, format and detect the operator of Bangladeshi mobile numbers in Laravel.",
    "keywords": ["laravel", "bangladesh", "phone", "mobile", "validation"],
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Sanvalabs",
            "email": "emnayonpu@gmail.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/support": "^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "phpunit/phpunit": "^11.0|^12.0"
    },
    "autoload": {
        "psr-4": {
            "Sanvalabs\\BdPhone\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Sanvalabs\\BdPhone\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Sanvalabs\\BdPhone\\BdPhoneServiceProvider"
            ],
            "aliases": {
                "BdPhone": "Sanvalabs\\BdPhone\\Facades\\BdPhone"
            }
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}